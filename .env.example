# PostgreSQL
POSTGRES_DB=yesornot
POSTGRES_USER=yesornot
POSTGRES_PASSWORD=change-me-in-production

# Django
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
DJANGO_DEBUG=False
# Derrière Nginx, * est sûr. Pour restreindre : localhost,yes-or-not.fr
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://yes-or-not.fr,https://dev.yes-or-not.fr

# Brevo (ex-Sendinblue) – API transactionnelle
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=contact@yesornot.fr
BREVO_SENDER_NAME=Yes or Not
BREVO_RECIPIENT_EMAIL=contact@yesornot.fr

# Docker
PORT=80
